module SieveSqrt where

lat IsPrime where
  type = Bool
  leq = (>=)
  join = (&&)
  meet = (||)

rel Limit: Int
rel Candidate: Int
rel Prime: Int, IsPrime

rule firstCandidate:
  Limit limit,
  if (limit >= 2)
  ----------------
  |- Candidate 2

rule nextCandidate:
  Limit limit,
  Candidate n,
  if ((n + 1) <= limit)
  ---------------------
  |- Candidate (n + 1)

rule assumePrime:
  Candidate n
  ---------------
  |- Prime n True

rule markComposite:
  Candidate divisor,
  Candidate number,
  if ((divisor < number) && (((divisor * divisor) <= number) && ((number `mod` divisor) == 0)))
  -----------------------------------
  |- Prime number False

query allPrimality: Prime - -
